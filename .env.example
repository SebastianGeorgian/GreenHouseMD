# Greenhouse Monitor - configuration template
#
#   cp .env.example .env
#   nano .env
#
# .env holds real secrets and is ignored by git (see .gitignore): never commit it.
# Values marked REQUIRED must be set or the services refuse to start.

# --- PostgreSQL (used by app.py, greenhouse_monitor.py, display_monitor.py) ---
DB_NAME=greenhouse
DB_USER=pi_user
# REQUIRED
DB_PASSWORD=change-me
DB_HOST=localhost

# --- Web dashboard (app.py) ---
# REQUIRED: random session key, generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=
# REQUIRED: dashboard login name
GH_USER=admin
# REQUIRED: password hash, generate with: python3 generate_hash.py
GH_PASS_HASH=

# --- Telegram alerts (optional: leave empty to disable) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# minimum seconds between two alerts of the same kind
ALERT_COOLDOWN_SECONDS=300

# --- Sensor ingest API: POST /api/ingest (optional) ---
# If set, clients must send it in the X-API-Key header; empty = no key required.
INGEST_API_KEY=
# rate limit per client IP: at most INGEST_RATE_MAX_REQ requests per INGEST_RATE_WINDOW_SEC seconds
INGEST_RATE_WINDOW_SEC=10
INGEST_RATE_MAX_REQ=60

# --- Outdoor weather location (default: Constanta, RO) ---
WEATHER_LAT=44.18
WEATHER_LON=28.65

# seconds without climate readings before the dashboard shows the sensors as offline
CLIMATE_OFFLINE_SEC=900

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
